---
---
{
  "articles": [
{% assign list = site.articles | sort: "date" | reverse %}{% for a in list %}{% assign cat = a.section %}{% if a.exclusive %}{% assign cat = cat | append: " · Exclusive" %}{% endif %}{% assign img = a.image | default: "" %}    {
      "headline": {{ a.title | jsonify }},
      "url": {{ a.url | relative_url | jsonify }},
      "category": {{ cat | jsonify }},
      "section": {{ a.section | jsonify }},
      "summary": {{ a.summary | default: "" | jsonify }},
      "author": {{ a.author | default: "Staff Writer" | jsonify }},
      "date": {{ a.date | date: "%Y-%m-%d" | jsonify }},
      "image": {{ img | relative_url | jsonify }},
      "image_alt": {{ a.image_alt | default: a.title | jsonify }},
      "fit_image": {% if a.image_fit %}true{% else %}false{% endif %}
    }{% unless forloop.last %},{% endunless %}
{% endfor %}  ]
}
